# ==============================================================================
# DISCORD CONFIGURATION
# ==============================================================================
# URL Webhook Discord (Channel Settings -> Integrations -> Webhooks -> New Webhook)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# ==============================================================================
# SEARCH PARAMETERS (MULTI-SEARCH & MULTI-LOCATION)
# ==============================================================================
# Kata kunci / posisi lowongan (bisa satu atau beberapa dipisahkan tanda koma)
SEARCH_TERMS=Frontend Developer, Software Engineer, Web Developer

# Lokasi lowongan (bisa satu atau beberapa dipisahkan tanda koma)
LOCATIONS=Indonesia, Jakarta, Remote

# Rentang waktu usia lowongan dalam jam (default: 24 jam terakhir)
HOURS_OLD=24

# Jumlah lowongan yang dicari per kombinasi query & situs (default: 15)
RESULTS_WANTED=15

# Hanya lowongan remote? (true / false)
IS_REMOTE=false

# ==============================================================================
# TOP COMPANY FILTERING & CLASSIFICATION (BIG 4, TECH GIANTS, BANKING, FMCG)
# ==============================================================================
# Mode Filter Perusahaan:
# - highlight : Kirim semua loker, tapi jika dari Big 4 / Top Tech / Bank / FMCG,
#               beri badge emas dan prioritas di atas (Direkomendasikan).
# - only_top  : Eksklusif HANYA kirim lowongan dari perusahaan Top Tier.
# - all       : Kirim semua lowongan apa adanya tanpa pembedaan.
FILTER_MODE=highlight

# Tambahan perusahaan top kustom di luar bawaan (pisahkan koma jika ada)
CUSTOM_TOP_COMPANIES=

# ==============================================================================
# SCRAPER SETTINGS
# ==============================================================================
# Situs yang di-scrape dipisahkan tanda koma (pilihan: linkedin, indeed)
SITE_NAMES=linkedin,indeed

# Jika LinkedIn gagal atau 0 hasil, fallback otomatis ke Indeed (true / false)
ENABLE_INDEED_FALLBACK=true

# Domain negara untuk Indeed (default: indonesia)
COUNTRY_INDEED=indonesia

# ==============================================================================
# DEDUPLICATION & STORAGE
# ==============================================================================
# File penyimpan ID/URL lowongan yang sudah pernah dikirim
SEEN_JOBS_FILE=seen_jobs.json

# Maksimal jumlah riwayat lowongan yang disimpan agar ukuran file tetap efisien
MAX_SEEN_HISTORY=1000

# Jeda pengiriman antar embed ke Discord dalam detik (mencegah rate limit)
DELAY_BETWEEN_ALERTS=1.0

# Jalankan dalam mode preview tanpa mengirim ke Discord dan tanpa menyimpan riwayat
DRY_RUN=false
