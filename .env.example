# ==============================================================================
# DISCORD MULTI-STREAM WEBHOOKS CONFIGURATION
# ==============================================================================
# Webhook Default / Fallback (Jika webhook stream spesifik di bawah tidak diisi):
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_DEFAULT_WEBHOOK

# Webhook Khusus Stream 1: Tech & Engineering (#tech-dev)
# Mencakup: Software Engineer, Backend, Frontend, Fullstack, DevOps, Mobile
DISCORD_WEBHOOK_TECH=https://discord.com/api/webhooks/YOUR_TECH_WEBHOOK

# Webhook Khusus Stream 2: Data & AI (#data-ai)
# Mencakup: Data Scientist, Data Engineer, Data Analyst, Machine Learning, AI Engineer, BI
DISCORD_WEBHOOK_DATA=https://discord.com/api/webhooks/YOUR_DATA_WEBHOOK

# Webhook Khusus Stream 3: Product & Business Analysis (#product-biz)
# Mencakup: Product Manager, APM, Product Owner, Business Analyst, System Analyst
DISCORD_WEBHOOK_PRODUCT=https://discord.com/api/webhooks/YOUR_PRODUCT_WEBHOOK

# ==============================================================================
# AI EXTRACTION SERVICE (OPTIONAL - VPS MICROSERVICE / LLM API)
# ==============================================================================
# Jika URL diisi, bot akan mengirim deskripsi loker ke AI VPS untuk ekstraksi mendalam.
# Jika dibiarkan KOSONG, bot otomatis menggunakan rule-based regex extractor bawaan.
AI_API_URL=
AI_API_KEY=

# ==============================================================================
# CONFIG FILE PATH
# ==============================================================================
# Seluruh pengaturan search terms, lokasi, sites, negative keywords, allowed levels,
# dan katalog top companies diatur terpusat di config.json.
CONFIG_JSON_PATH=config.json

# ==============================================================================
# ENVIRONMENT OVERRIDES (OPSIONAL - MENGABAIKAN CONFIG.JSON JIKA DIISI)
# ==============================================================================
# SEARCH_TERMS=Software Engineer, Product Manager, Data Analyst
# LOCATIONS=Indonesia, Jakarta, Remote
# FILTER_MODE=highlight
# HOURS_OLD=24
# RESULTS_WANTED=15

# ==============================================================================
# DEDUPLICATION & STORAGE
# ==============================================================================
SEEN_JOBS_FILE=seen_jobs.json
MAX_SEEN_HISTORY=1000
DELAY_BETWEEN_ALERTS=1.0
DRY_RUN=false
